{
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "single-spa-angular": ["./libs/single-spa-angular/index.ts"],
      "single-spa-angular/elements": [
        "./libs/single-spa-angular/elements/src/index.ts"
      ],
      "single-spa-angular/internals": [
        "./libs/single-spa-angular/internals/src/index.ts"
      ],
      "single-spa-angular/parcel": [
        "./libs/single-spa-angular/parcel/src/index.ts"
      ]
    },
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2018", "dom"],
    "moduleResolution": "bundler",
    "typeRoots": ["node_modules/@types"],
    "strict": true,
    "sourceMap": true,
    "declaration": true,
    "noEmitOnError": true,
    "importHelpers": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true
  },
  "exclude": ["cypress"]
}
